NODECANVAS_DATABASE_PATH=./Backend/data/nodecanvas.db
NODECANVAS_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Any OpenAI-compatible chat-completions endpoint. When omitted, the backend
# uses the deterministic local provider so development and tests still run.
NODECANVAS_LLM_BASE_URL=https://api.example.com/v1
NODECANVAS_LLM_API_KEY=
NODECANVAS_LLM_MODEL=

# Optional production semantic retrieval. SQLite remains the primary store;
# pgvector is a rebuildable index of knowledge chunks.
NODECANVAS_PGVECTOR_DATABASE_URL=postgresql://nodecanvas:nodecanvas@127.0.0.1:5432/nodecanvas
NODECANVAS_EMBEDDING_BASE_URL=https://api.example.com/v1
NODECANVAS_EMBEDDING_API_KEY=
NODECANVAS_EMBEDDING_MODEL=text-embedding-3-small
NODECANVAS_EMBEDDING_DIMENSIONS=384
